{
  "name": "opengta-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "test": "vitest",
    "test:bench": "vitest run --config vitest.bench.config.ts",
    "test:e2e": "playwright test",
    "test:canary": "OPENGTA_CANARY=1 playwright test tests/e2e/canary-lecce.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.14.0",
    "h3-js": "^4.5.0",
    "pixi.js": "^8.19.0"
  }
}
