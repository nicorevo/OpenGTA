# Local VPS-10 service configuration. NEVER commit real values (.env is gitignored).
# Copy to .env and fill in your own values.

# Mapillary credential (panel account -> developers). The current public API
# (graph.mapillary.com, verified VPS-10) authenticates it as a Bearer token.
MAPILLARY_CLIENT_ID=MLY|YOUR_CLIENT_ID_HERE
MAPILLARY_BASE_URL=https://graph.mapillary.com

# Public Overpass endpoint for OSM collection.
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# File cache for evidence/profile (spec 54 level 2).
VPS_CACHE_DIR=.vps-cache
VPS_TTL_MS=604800000

# Provider rate limits (requests per minute, token bucket).
VPS_RATE_LIMIT_PER_MIN=60

# HTTP port for GET /v1/profile.
VPS_PORT=8787

# Google Gemini vision model (VPS-11, optional). Without a key the service
# runs OSM-only (no vision). The key lives server-side only (spec 82-83).
# Get a key from https://aistudio.google.com/apikey.
# NOTE (verified 2026-09-23): fresh keys sit on the FREE TIER with a small
# daily quota (~20 generate_content requests/day/model, ~10 rapid calls per
# minute) — a 429 names the exact quota and a retry delay; the analyzer
# retries 429s (Retry-After aware). Check plan/billing at
# https://ai.dev/rate-limit if vision coverage looks capped.
# Note: gemini-3.6-flash is the fast vision model (verified 2026-09-23:
# 2.5-flash is no longer available to new API users); override GEMINI_MODEL
# with a Pro model for a slower, higher-quality classification.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
